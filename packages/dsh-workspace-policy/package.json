{
  "name": "@brain/dsh-workspace-policy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Always-on system prompt rules for the OSS-backed workspace (no chmod, no symlink, git metadata on local disk).",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-system-prompt": "*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
