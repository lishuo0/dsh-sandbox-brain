{
  "name": "@brain/dsh-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One database handle per brain process (local SQLite or PostgreSQL); every persistence consumer injects it.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./row": {
      "types": "./lib/row.d.ts",
      "default": "./lib/row.js"
    },
    "./sqlite": {
      "types": "./lib/sqlite.d.ts",
      "default": "./lib/sqlite.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.0"
  }
}
