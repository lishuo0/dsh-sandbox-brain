{
  "name": "@brain/dsh-schedule-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Session reminders for hand/brain separation. Tools write dsh_schedule_tasks; the platform claims due rows and delivers them through SendMessage. This package does not run a timer and does not call the platform.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-schedule": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-schedule": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "typescript": "^5.8.0"
  }
}
